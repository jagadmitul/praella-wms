# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4300
# Comma-separated list of origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3300

# ---------------------------------------------------------------------------
# Database — matches docker-compose.yml (host port 5437)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://wms:wms_password@localhost:5437/wms?schema=public
# Separate database used by `pnpm test:e2e`; it is migrated and truncated freely.
TEST_DATABASE_URL=postgresql://wms:wms_password@localhost:5437/wms_test?schema=public

# ---------------------------------------------------------------------------
# Redis — cache + BullMQ queues (host port 6381)
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=
REDIS_DB=0
# Namespaces BullMQ keys. Give each environment its own value.
QUEUE_PREFIX=wms
# Set to false to run the API with caching and queues disabled (no Redis needed).
REDIS_ENABLED=true

# ---------------------------------------------------------------------------
# Auth — REPLACE BOTH SECRETS BEFORE DEPLOYING ANYWHERE REAL
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-please-32chars
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-please-32chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=200
# Tighter limit for sign-in / sign-up, which are the endpoints worth brute-forcing.
AUTH_THROTTLE_LIMIT=10

# ---------------------------------------------------------------------------
# Caching
# ---------------------------------------------------------------------------
CACHE_TTL_SECONDS=60

# ---------------------------------------------------------------------------
# Seed — credentials created by `pnpm db:seed`
# ---------------------------------------------------------------------------
SEED_PASSWORD=Praella@2026
